  nodes:
  - speakerName: Antonio
    line: "Oye... \xBFt\xFA tambi\xE9n has o\xEDdo hablar del vidrio?"
    choices:
    - moodLabel: Ignorarlo
      resultingLine: (Silencio)
      nextNodeIndex: 1
    - moodLabel: Responder borde
      resultingLine: "\xBFA ti qu\xE9 m\xE1s te da?"
      nextNodeIndex: 2
    - moodLabel: Furioso
      resultingLine: "\xA1QU\xC9 VIDRIO NI QU\xC9 NARICES!"
      nextNodeIndex: 3
